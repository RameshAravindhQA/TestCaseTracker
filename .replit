modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Start TestCase Tracker"

[[workflows.workflow]]
name = "Start TestCase Tracker"
author = 41979910
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/index.ts"

[[ports]]
localPort = 5000
externalPort = 80
