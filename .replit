modules = ["nodejs-20", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TestCaseTracker"

[[workflows.workflow]]
name = "TestCaseTracker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TestCaseTracker && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 38143
externalPort = 3000

[nix]
channel = "stable-25_05"
