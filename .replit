modules = ["nodejs-20", "postgresql-16", "python-3.11"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-24_05"
packages = ["unzipNLS"]

[workflows]
runButton = "TestCaseTracker Fixed"

[[workflows.workflow]]
name = "Start TestCaseTracker"
author = 41980973
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TestCaseTracker && npm install && node dev.js"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TestCaseTracker"

[[workflows.workflow]]
name = "TestCaseTracker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TestCaseTracker && node dev.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "TestCaseTracker Fixed"
author = 41966107
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TestCaseTracker && node dev.js"

[agent]
expertMode = true
