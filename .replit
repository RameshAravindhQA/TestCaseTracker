modules = ["nodejs-20"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TestCaseTracker"

[[workflows.workflow]]
name = "TestCaseTracker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TestCaseTracker && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 41547
externalPort = 3000
