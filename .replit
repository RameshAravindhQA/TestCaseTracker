modules = ["nodejs-20"]

[workflows]
runButton = "Start Application"

[[workflows.workflow]]
name = "Start Application"
author = 42063782
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f \"tsx server/index.ts\" 2>/dev/null || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node dev.js"
