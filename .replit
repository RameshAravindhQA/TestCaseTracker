modules = ["nodejs-20", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TestCaseTracker"

[[workflows.workflow]]
name = "TestCaseTracker"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TestCaseTracker && npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Run TestCase Tracker"
author = 43169708
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TestCaseTracker && npm run dev"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 37425
externalPort = 3002

[[ports]]
localPort = 39431
externalPort = 3001

[[ports]]
localPort = 42219
externalPort = 3000

[nix]
channel = "stable-25_05"
